get" style="html=1;rounded=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;fontColor=#000000;edgeStyle=none;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5263;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PostReport" target="EventPost"><mxGeometry relative="1" as="geometry"><mxPoint x="2655" y="1146" as="sourcePoint"/><mxPoint x="2371" y="1280" as="targetPoint"/><Array as="points"><mxPoint x="2655" y="1280"/></Array></mxGeometry></mxCell><mxCell id="c203" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="c202"><mxGeometry x="-0.88" y="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c204" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="c202"><mxGeometry x="0.88" y="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c205" value="target" style="html=1;rounded=0;strokeColor=#000000;fontFamily=Helvetica;fontSize=11;fontColor=#000000;edgeStyle=none;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.7853;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="PageReport" target="Page"><mxGeometry relative="1" as="geometry"><mxPoint x="2775" y="1146" as="sourcePoint"/><mxPoint x="1476" y="1200" as="targetPoint"/><Array as="points"><mxPoint x="2775" y="2080"/><mxPoint x="1540" y="2080"/><mxPoint x="1540" y="1200"/></Array></mxGeometry></mxCell><mxCell id="c206" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="c205"><mxGeometry x="-0.88" y="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c207" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontStyle=1;fontFamily=Helvetica;fontSize=11;fontColor=#000000;" vertex="1" connectable="0" parent="c205"><mxGeometry x="0.88" y="0" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;Quasario – Class Diagram&lt;/b&gt;&lt;br&gt;Laravel backend · React frontend · 2026-10-22" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=#000000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="380" height="50" as="geometry"/></mxCell><mxCell id="note" value="Notes:&lt;br&gt;• Visitor has no stored data, so it is not a class.&lt;br&gt;• Verified user = User with isVerified = true (state, not a subclass); only VerificationRequest.accept() sets it, Admin.revokeTrustMark() clears it.&lt;br&gt;• Page is created by completeRegistration(); Event city = owner page city; Endorsement page = request.requester.page (derived).&lt;br&gt;• Account subclasses are stored in one table (role); Section and Report subclasses likewise (type / target).&lt;br&gt;• Any Event.update() returns status to PENDING; only ACCEPTED events are public.&lt;br&gt;• Deleting an Account or a reported Page cascades to all linked data." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1600" y="1600" width="540" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>